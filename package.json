{
  "name": "strata",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test src/*.test.ts server/*.test.js"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "mysql2": "^3.24.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
